RewriteEngine On

# Preserve old website URLs. Exact matches only; no homepage catch-all.
RewriteRule ^services/disclusion\-time\-reduction\-therapy/?$ /services/tmj-tmd-therapy/ [R=301,L,NE]
RewriteRule ^services/myobrace/?$ /services/jaw-development-therapy/ [R=301,L,NE]
RewriteRule ^services/laser\-gum\-contouring/?$ /services/gum-lift-procedure/ [R=301,L,NE]
RewriteRule ^services/neuromuscular\-tmj\-therapy/?$ /services/tmj-tmd-therapy/ [R=301,L,NE]
RewriteRule ^services/vivos/?$ /services/sleep-dentistry/ [R=301,L,NE]
RewriteRule ^services/family\-dentist/?$ /services/family-dentistry/ [R=301,L,NE]
RewriteRule ^services/dental\-bonding/?$ /services/dental-fillings-and-bonding/ [R=301,L,NE]
RewriteRule ^services/root\-canal\-treatment/?$ /services/root-canals/ [R=301,L,NE]
RewriteRule ^services/invisalign/?$ /services/orthodontics-invisalign/ [R=301,L,NE]
RewriteRule ^contact\-us/?$ /contact/ [R=301,L,NE]
RewriteRule ^about\-us/?$ /about/ [R=301,L,NE]
RewriteRule ^cdcp\-eligibility\-co\-pay\-calculator\-109\-dental\-edmonton/?$ /cdcp-insurance/ [R=301,L,NE]
RewriteRule ^services/emergency\-dental/?$ /services/emergency-dentist/ [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
